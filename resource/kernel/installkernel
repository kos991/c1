#!/bin/bash
# XanMod-only adapter informed by Eric86777/vps-tcp-tune v5.4.19
# Reference commit: 7c2301cb3395ea8363ae7401719b416eb830714f
# No upstream toolbox, network tuning, automatic kernel cleanup, or automatic reboot.
# Repository/package contract: https://xanmod.org/ (APT Repository and psABI table).
# Keep the signed source for future APT upgrades; validate the installed metapackage's
# dependency, never the newest unrelated kernel. Restore repairs missing boot files
# without install-only space, Secure Boot, or DKMS gates. Reboots remain manual.

fail() { printf 'ERROR: %s\n' "$*" >&2; return 1; }

installedPackages() {
    dpkg-query -W -f='${binary:Package} ${db:Status-Status}\n' 'linux-image-*' 'linux-headers-*' 'linux-xanmod*' 2>/dev/null |
        awk '$2 == "installed" {sub(/:.*/, "", $1); print $1}'
}

# Fail conservatively when any CPU lacks an ISA feature. Do not execute downloaded detectors.
cpuLevel() {
    local flags feature level=3 found=0
    while IFS= read -r flags; do
        found=1
        for feature in cx16 lahf_lm popcnt pni ssse3 sse4_1 sse4_2; do
            [[ " $flags " = *" $feature "* ]] || { echo 1; return; }
        done
        for feature in avx avx2 bmi1 bmi2 f16c fma abm movbe xsave; do
            [[ " $flags " = *" $feature "* ]] || level=2
        done
    done < <(awk -F: '/^flags[ \t]*:/ {print $2}' /proc/cpuinfo)
    [[ $found = 1 ]] || level=1
    echo "$level"
}

candidatePackages() {
    local suite=$1 level=$2
    [[ $level =~ ^[123]$ ]] || return 1
    [[ $suite = bookworm || $suite = trixie ]] || return 1
    if [[ $suite = trixie && $level != 1 ]]; then
        echo "linux-xanmod-x64v$level"
    fi
    echo "linux-xanmod-lts-x64v$level"
}

selectPackage() {
    local package candidate
    while read -r package; do
        candidate=$(LC_ALL=C apt-cache policy "$package" | awk '/Candidate:/ {print $2; exit}')
        if [[ -n $candidate && $candidate != '(none)' ]]; then
            echo "$package"
            return 0
        fi
    done < <(candidatePackages "$1" "$2")
    fail 'No installable XanMod candidate matches this CPU and Debian release.'
}

installedImageDependency() {
    local package=$1 dependencies dependency image= status relation= required= version
    local pattern='^[[:space:]]*(linux-image-[a-zA-Z0-9.+-]+)(:amd64)?([[:space:]]+\((<<|<=|=|>=|>>)[[:space:]]+([^ )]+)\))?[[:space:]]*$'
    local -a entries=()
    [[ $(dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null) = installed ]] || return 1
    dependencies=$(dpkg-query -W -f='${Depends}' "$package" 2>/dev/null) || return 1
    IFS=, read -r -a entries <<<"$dependencies"
    for dependency in "${entries[@]}"; do
        [[ $dependency =~ $pattern ]] || continue
        [[ -z $image ]] || { fail "Ambiguous image dependencies for $package."; return 1; }
        image=${BASH_REMATCH[1]}
        relation=${BASH_REMATCH[4]}
        required=${BASH_REMATCH[5]}
    done
    [[ -n $image ]] || { fail "No direct image dependency for $package."; return 1; }
    status=$(dpkg-query -W -f='${db:Status-Status}' "$image" 2>/dev/null) || return 1
    [[ $status = installed ]] || { fail "Image dependency $image is not installed."; return 1; }
    if [[ -n $relation ]]; then
        version=$(dpkg-query -W -f='${Version}' "$image" 2>/dev/null) || return 1
        dpkg --compare-versions "$version" "$relation" "$required" || {
            fail "Image dependency $image does not satisfy $relation $required."; return 1;
        }
    fi
    printf '%s\n' "$image"
}

isDebianImage() {
    local package=$1 metadata status source maintainer
    [[ $package =~ ^linux-image-[0-9].*-amd64$ && $package != *xanmod* ]] || return 1
    metadata=$(dpkg-query -W -f='${db:Status-Status}|${source:Package}|${Maintainer}' "$package" 2>/dev/null) || return 1
    IFS='|' read -r status source maintainer <<<"$metadata"
    [[ $status = installed && ( $source = linux || $source = linux-signed-amd64 ) && $maintainer = *'Debian Kernel Team'* ]]
}

prepareBootFiles() {
    local release=$1 mode=-u
    [[ -s /boot/vmlinuz-$release && -d /lib/modules/$release ]] || { fail 'Installed kernel artifacts are incomplete.'; return 1; }
    [[ -s /boot/initrd.img-$release ]] || mode=-c
    update-initramfs "$mode" -k "$release" && update-grub || return 1
    [[ -s /boot/initrd.img-$release ]] && grep -Fq "vmlinuz-$release" /boot/grub/grub.cfg || {
        fail 'Requested kernel is missing from boot files/GRUB.'; return 1;
    }
}

fallbackKernels() {
    local package release
    while read -r package; do
        isDebianImage "$package" || continue
        release=${package#linux-image-}
        [[ -s /boot/vmlinuz-$release && -s /boot/initrd.img-$release && -d /lib/modules/$release ]] && echo "$package"
    done < <(installedPackages)
}

showStatus() {
    printf 'Running kernel: %s\n' "$(uname -r)"
    printf 'Architecture: %s\n' "$(dpkg --print-architecture)"
    printf 'CPU package level: x64v%s\n' "$(cpuLevel)"
    printf 'Installed kernel packages:\n'
    installedPackages
    printf 'Verified Debian fallback kernels:\n'
    fallbackKernels
    printf 'BBR module version: '
    if [[ -r /sys/module/tcp_bbr/version ]]; then
        cat /sys/module/tcp_bbr/version
    elif command -v modinfo >/dev/null 2>&1; then
        modinfo -F version tcp_bbr 2>/dev/null
    fi
    printf '\nNo version 3 evidence means BBR v3 is not verified.\n'
    sysctl net.ipv4.tcp_congestion_control net.core.default_qdisc 2>/dev/null
}

preflight() {
    local action=${1:-install} ID VERSION_CODENAME secureboot file available rootAvailable
    [[ -r /etc/os-release ]] || { fail 'Cannot identify the OS.'; return 1; }
    . /etc/os-release
    [[ $ID = debian && ( $VERSION_CODENAME = trixie || $VERSION_CODENAME = bookworm ) ]] || {
        fail 'This adapter supports Debian 12/13 only.'; return 1;
    }
    [[ $(dpkg --print-architecture) = amd64 ]] || {
        fail 'XanMod packages are amd64 only. The existing kernel and tuning were not changed.'; return 1;
    }
    command -v systemd-detect-virt >/dev/null 2>&1 || { fail 'systemd is required.'; return 1; }
    if systemd-detect-virt --container --quiet; then
        fail 'Containers share the host kernel; install on the host instead.'; return 1
    fi
    [[ -d /run/systemd/system ]] || { fail 'Requires a running systemd host.'; return 1; }
    command -v update-grub >/dev/null 2>&1 && command -v update-initramfs >/dev/null 2>&1 || {
        fail 'GRUB and initramfs-tools are required; this adapter will not replace your bootloader.'; return 1;
    }
    # Recovery must work when the running kernel or GRUB files need repair.
    [[ $action = install ]] || return 0
    [[ -s /boot/grub/grub.cfg && -s /boot/vmlinuz-$(uname -r) ]] || {
        fail 'Cannot verify the active boot kernel and GRUB configuration.'; return 1;
    }
    for file in /sys/firmware/efi/efivars/SecureBoot-*; do
        [[ -f $file ]] || continue
        secureboot=$(od -An -j4 -N1 -tu1 "$file" | tr -d ' ') || return 1
        [[ $secureboot = 0 ]] || { fail 'Secure Boot enabled or unreadable; refusing an unverified kernel boot.'; return 1; }
    done
    available=$(df -Pk /boot | awk 'NR==2 {print $4}')
    rootAvailable=$(df -Pk / | awk 'NR==2 {print $4}')
    [[ $available =~ ^[0-9]+$ && $rootAvailable =~ ^[0-9]+$ ]] || return 1
    (( available >= 786432 && rootAvailable >= 3145728 )) || { fail 'Need 768 MiB free in /boot and 3 GiB on /.'; return 1; }
    if command -v dkms >/dev/null 2>&1 && [[ -n $(dkms status) ]]; then
        fail 'DKMS modules detected. Verify their XanMod compatibility before a manual kernel change.'; return 1
    fi
    printf 'Preflight OK: %s, x64v%s. No system settings changed.\n' "$VERSION_CODENAME" "$(cpuLevel)"
    printf 'Package preference:\n'
    candidatePackages "$VERSION_CODENAME" "$(cpuLevel)"
}

retireLegacyCleanup() {
    local legacy=/etc/rc_kernel.local backup cronFile
    [[ -f $legacy ]] || return 0
    grep -Fq 'grep -Fv $(uname -r)' "$legacy" && grep -Fq 'apt autoremove' "$legacy" || return 0
    backup=/opt/de_GWD/kernel-backup
    install -d -m 0700 "$backup" || return 1
    cp -p "$legacy" "$backup/rc_kernel.local.$(date +%Y%m%d%H%M%S).$$" || return 1
    cronFile=$(mktemp) || return 1
    if crontab -l >"$cronFile" 2>/dev/null; then
        sed -i '\|/etc/rc_kernel.local|d' "$cronFile"
        crontab "$cronFile" || { rm -f "$cronFile"; return 1; }
    fi
    rm -f "$cronFile" "$legacy"
}

protectFallback() {
    local -a fallback=()
    mapfile -t fallback < <(fallbackKernels)
    (( ${#fallback[@]} )) || { fail 'No usable Debian fallback kernel; choose Restore Debian first.'; return 1; }
    local running="linux-image-$(uname -r)"
    if [[ $(dpkg-query -W -f='${db:Status-Status}' "$running" 2>/dev/null) = installed ]]; then
        apt-mark manual "$running" || return 1
    fi
    apt-mark manual "${fallback[@]}" || return 1
}

configureRepo() {
    local suite=$1 temp
    temp=$(mktemp -d) || return 1
    if ! curl -q -fsSL https://dl.xanmod.org/archive.key -o "$temp/archive.key" ||
       ! gpg --batch --yes --dearmor -o "$temp/archive.gpg" "$temp/archive.key"; then
        rm -rf "$temp"; return 1
    fi
    install -d -m 0755 /etc/apt/keyrings || { rm -rf "$temp"; return 1; }
    install -m 0644 "$temp/archive.gpg" /etc/apt/keyrings/c1-xanmod.gpg || { rm -rf "$temp"; return 1; }
    rm -rf "$temp"
    # Replace only the two known old installer source files; preserve unrelated repositories.
    local file backup=/opt/de_GWD/kernel-backup
    install -d -m 0700 "$backup" || return 1
    for file in /etc/apt/sources.list.d/xanmod-kernel.list /etc/apt/sources.list.d/xanmod-release.list; do
        [[ -f $file ]] || continue
        if grep -Eq '^[[:space:]]*deb .*deb\.xanmod\.org' "$file"; then
            cp -p "$file" "$backup/$(basename "$file").$(date +%Y%m%d%H%M%S).$$" || return 1
            rm -f "$file" || return 1
        else
            fail "Unexpected source content in $file; refusing to overwrite."; return 1
        fi
    done
    printf 'deb [signed-by=/etc/apt/keyrings/c1-xanmod.gpg] https://deb.xanmod.org %s main\n' "$suite" >/etc/apt/sources.list.d/c1-xanmod.list
}

confirm() {
    local reply
    printf '%s\n' "$1"
    read -r -p 'Type YES to continue (anything else cancels): ' reply || return 1
    [[ $reply = YES ]]
}

installKernel() {
    local suite package image release
    preflight install || return 1
    [[ -n $(fallbackKernels) ]] || { fail 'Install a Debian fallback first (menu 2).'; return 1; }
    confirm 'Install/update XanMod; keep all existing kernels and network settings?' || return 0
    retireLegacyCleanup && protectFallback || return 1
    apt-get update && apt-get install --no-remove -y curl gnupg ca-certificates || return 1
    suite=$(. /etc/os-release; printf '%s' "$VERSION_CODENAME")
    configureRepo "$suite" || return 1
    # Preserve the signed repository even on failure so existing installations
    # remain upgradable and an interrupted installation can be retried.
    apt-get update || return 1
    package=$(selectPackage "$suite" "$(cpuLevel)") || return 1
    apt-get install --no-remove -y "$package" || return 1
    image=$(installedImageDependency "$package") || return 1
    [[ $image = linux-image-*xanmod* ]] || { fail 'Selected package does not depend on a XanMod image.'; return 1; }
    release=${image#linux-image-}
    prepareBootFiles "$release" || return 1
    apt-mark manual "$package" "$image" || return 1
    printf 'Installed %s; running %s. Select the new kernel in GRUB and reboot in a maintenance window.\n' "$release" "$(uname -r)"
    printf 'No automatic reboot, qdisc change, or old-kernel removal. BBR v3 requires post-reboot verification.\n'
}

restoreDebian() {
    local image
    preflight restore || return 1
    confirm 'Install/repair the Debian fallback kernel without removing XanMod?' || return 0
    retireLegacyCleanup || return 1
    apt-get update && apt-get install --no-remove --reinstall -y linux-image-amd64 || return 1
    image=$(installedImageDependency linux-image-amd64) || return 1
    isDebianImage "$image" || { fail 'The fallback dependency is not a Debian kernel package.'; return 1; }
    # Reinstall the actual image: reinstalling only its metapackage does not
    # restore a deleted vmlinuz or modules directory.
    apt-get install --no-remove --reinstall -y "$image" || return 1
    prepareBootFiles "${image#linux-image-}" || return 1
    apt-mark manual linux-image-amd64 || return 1
    protectFallback || return 1
    echo 'Debian fallback ready. Select it in GRUB and reboot manually before removing XanMod.'
}

removeXanmod() {
    local -a packages=()
    preflight remove || return 1
    fallbackKernels | grep -Fxq "linux-image-$(uname -r)" || {
        fail 'Boot a verified, installed Debian fallback kernel before removing XanMod.'; return 1;
    }
    mapfile -t packages < <(installedPackages | grep -E '^linux-(image-|headers-|xanmod).*xanmod|^linux-xanmod')
    (( ${#packages[@]} )) || { echo 'No XanMod packages installed.'; return 0; }
    printf 'Packages to remove: %s\n' "${packages[*]}"
    confirm 'Remove only these XanMod packages? No autoremove will run.' || return 0
    retireLegacyCleanup && protectFallback || return 1
    apt-get -o APT::Get::AutomaticRemove=false purge -y "${packages[@]}" && update-grub || return 1
}

main() {
    local action=${1:---menu} choice
    case $action in
        --help|-h) echo 'Usage: installkernel [--status|--check|--install|--restore|--remove]'; return;;
        --status) showStatus; return;;
        --check) preflight; return;;
        --menu|--install|--restore|--remove) ;;
        *) fail "Unknown action: $action"; return 1;;
    esac
    (( EUID == 0 )) || { fail 'Run as root.'; return 1; }
    case $action in
        --install) installKernel; return;;
        --restore) restoreDebian; return;;
        --remove) removeXanmod; return;;
    esac
    while true; do
        printf '\nXanMod kernel management (no automatic reboot)\n1. Install/update XanMod\n2. Restore Debian fallback\n3. Remove XanMod after booting Debian\n4. Status\n5. Read-only preflight\n0. Return\n'
        read -r -p 'Select: ' choice || return 0
        case $choice in
            1) installKernel || return 1;;
            2) restoreDebian || return 1;;
            3) removeXanmod || return 1;;
            4) showStatus;;
            5) preflight || return 1;;
            0) return 0;;
            *) echo 'Invalid choice.';;
        esac
    done
}

if [[ ${BASH_SOURCE[0]} = "$0" ]]; then
    main "$@"
fi
