#!/bin/bash
source /opt/de_GWD/ui-node-lib
set -euo pipefail

tag=custom
if [[ -n ${2:-} ]]; then
    node_load nodeCU "$2"
    node_update "$NODE_CONF" --arg address "$address" '.v2nodeDIV.nodeCU.address=$address'
else
    node_load nodeCU
fi
outbound=$(node_outbound "$tag" "$address" "$tls" "$uuid" "$path")
routingDomain=$(jq -ce '.v2nodeDIV.nodeCU.rulesDomain // [] | if type == "array" and all(.[]; type == "string" and length > 0) then . else error("Invalid domain routing") end' "$NODE_CONF")
routingIP=$(jq -ce '.v2nodeDIV.nodeCU.rulesIP // [] | if type == "array" and all(.[]; type == "string" and length > 0) then . else error("Invalid IP routing") end' "$NODE_CONF")
node_remove "$tag"
node_put_outbound "$outbound"
node_rule "$tag" domain "$routingDomain"
node_rule "$tag" ip "$routingIP"
node_update "$NODE_CONF" '.v2nodeDIV.nodeCU.status="on"'
if [[ ${1:-} == r ]]; then systemctl restart vtrui >/dev/null; fi
