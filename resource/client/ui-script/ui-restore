#!/bin/bash
set -euo pipefail

# Restore de_GWD config from act-staged backup file
[[ -f /var/lib/de_GWD/restore/de_GWD_bak ]] || exit 1

# Validate file is regular and owned by www-data (post-act staging)
[[ -O /var/lib/de_GWD/restore/de_GWD_bak && ! -L /var/lib/de_GWD/restore/de_GWD_bak ]] || exit 1

# Restore config and re-apply dependent service configs
cp -p /var/lib/de_GWD/restore/de_GWD_bak /opt/de_GWD/0conf
chown root:www-data /opt/de_GWD/0conf
chmod 0660 /opt/de_GWD/0conf

# Re-sync derived configs from 0conf
[[ -n $(jq -r '.address.alias' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$') ]] && /opt/de_GWD/ui-markThis
/opt/de_GWD/ui-NodeOne
[[ $(jq -r '.v2nodeDIV.nodeSM.status' /opt/de_GWD/0conf 2>/dev/null) = "on" ]] && /opt/de_GWD/ui-NodeSM >/dev/null 2>&1 || true
[[ $(jq -r '.v2nodeDIV.nodeCU.status' /opt/de_GWD/0conf 2>/dev/null) = "on" ]] && /opt/de_GWD/ui-NodeCU >/dev/null 2>&1 || true
[[ $(jq -r '.v2nodeDIV.nodeDT.status' /opt/de_GWD/0conf 2>/dev/null) = "on" ]] && /opt/de_GWD/ui-NodeDT >/dev/null 2>&1 || true
[[ $(jq -r '.FORWARD.FWD1.status' /opt/de_GWD/0conf 2>/dev/null) = "on" ]] && /opt/de_GWD/ui-FWD1save >/dev/null 2>&1 || true
[[ $(jq -r '.FORWARD.Rproxy.client.status' /opt/de_GWD/0conf 2>/dev/null) = "on" ]] && /opt/de_GWD/ui-RproxyCsave >/dev/null 2>&1 || true
[[ $(jq -r '.FORWARD.Rproxy.server.status' /opt/de_GWD/0conf 2>/dev/null) = "on" ]] && /opt/de_GWD/ui-RproxySsave >/dev/null 2>&1 || true

# Restart dependent services
/opt/de_GWD/ui_4h
systemctl restart nftables 2>/dev/null || true
systemctl restart mosdns 2>/dev/null || true
systemctl restart vtrui 2>/dev/null || true
