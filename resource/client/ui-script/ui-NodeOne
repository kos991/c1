#!/bin/bash
source /opt/de_GWD/ui-node-lib
set -euo pipefail

domain=$(jq -er '.update.v2node.domain | select(type == "string" and length > 0)' "$NODE_CONF")
port=$(jq -r '.update.v2node.port // "443"' "$NODE_CONF")
tls=$(jq -r '.update.v2node.tls // ""' "$NODE_CONF")
uuid=$(jq -er '.update.v2node.uuid | select(type == "string" and length > 0)' "$NODE_CONF")
path=$(jq -r '.update.v2node.path // ""' "$NODE_CONF")
endpoint=$domain
if [[ $domain == *:* ]]; then endpoint="[$domain]"; fi
node_endpoint "$endpoint:$port"
outbound=$(node_outbound default "$endpoint:$port" "$tls" "$uuid" "$path")

node_update "$NODE_XRAY" --argjson outbound "$outbound" '
  {log:{access:"none",error:"none",loglevel:"none"},
   dns:{tag:"dnsflow",queryStrategy:"UseIP",disableCache:true,servers:["tcp+local://127.0.0.1:53"]},
   routing:{domainMatcher:"hybrid",domainStrategy:"AsIs",rules:[{type:"field",ip:["geoip:private"],network:"tcp,udp",outboundTag:"direct"}]},
   inbounds:[{port:9896,listen:"127.0.0.1",protocol:"dokodemo-door",settings:{network:"tcp,udp",followRedirect:true},streamSettings:{sockopt:{tproxy:"tproxy",mark:255,tcpFastOpen:true,tcpMptcp:true}},sniffing:{enabled:true,destOverride:["http","tls","quic"],routeOnly:true,metadataOnly:false}}],
   outbounds:[$outbound,{tag:"direct",protocol:"freedom",streamSettings:{sockopt:{mark:255,tcpFastOpen:true,tcpNoDelay:true}}}]}'

if [[ $(jq -r '.FORWARD.FWD0.status // "off"' "$NODE_CONF") == on ]]; then
    /opt/de_GWD/ui-FWD0save
fi
if [[ ${1:-} == f ]]; then
    node_update "$NODE_CONF" '.v2nodeDIV.nodeCU.status="off" | .v2nodeDIV.nodeDT.status="off"'
fi
if [[ ${2:-} == r ]]; then systemctl restart vtrui; fi
