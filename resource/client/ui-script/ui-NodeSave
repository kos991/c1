#!/bin/bash
source /opt/de_GWD/ui-node-lib
set -euo pipefail

RED='\E[1;31m'
GREEN='\E[1;32m'
WHITE='\E[1;37m'
cRES='\E[0m'
echo -e "${WHITE}[...]\c" && echo -e "\t${WHITE}Collect V2 node${cRES}\r\c"

# DNS answers are data, not nft syntax. Keep the existing set if resolution fails.
domains=$(mktemp /opt/de_GWD/mosdns/.domains_nodes.XXXXXX)
ips=$(mktemp /opt/de_GWD/nftables/.IP_V2NODE.XXXXXX)
trap 'rm -f -- "$domains" "$ips"' EXIT
jq -r '.v2node[]?.domain // empty | split(":")[0]' "$NODE_CONF" | sort -u | while IFS= read -r domain; do
    [[ -n $domain && $domain =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] || continue
    printf '%s\n' "$domain" >>"$domains"
    dig @127.0.0.1 "$domain" -4 -p 5332 +short 2>/dev/null | jq -R -s -c 'split("\n")[:-1]' >>"$ips" || :
done
addresses=$(jq -sc 'add // [] | map(select(test("^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"))) | unique' "$ips")
if [[ -s $domains && $addresses == '[]' ]]; then exit 1; fi
node_nft_set V2NODE "$addresses"
chown root:root "$domains"
chmod 0600 "$domains"
mv -f -- "$domains" /opt/de_GWD/mosdns/domains_nodes
[[ ${1:-} == r ]] && systemctl restart mosdns || true
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Collect V2 node${cRES}"
