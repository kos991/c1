#!/bin/bash
set -e
. /opt/de_GWD/ui-dns-lib

# Bypass the proxy via SmartDNS's domestic port without tearing down the
# independent mosdns, CoreDNS, firewall or DNS resolver configuration.
/opt/de_GWD/ui-smartDNS
gwd_pihole_upstream 5331
gwd_resolver_local
touch /opt/de_GWD/nftables/proxy.disabled
if nft list chain ip de_GWD prerouting >/dev/null 2>&1; then
    nft flush chain ip de_GWD prerouting
fi
if nft list chain ip de_GWD output >/dev/null 2>&1; then
    nft flush chain ip de_GWD output
fi
systemctl stop vtrui
ip rule del table 220 >/dev/null 2>&1 || :
ip route flush table 220 >/dev/null 2>&1 || :
ip route flush cache >/dev/null 2>&1 || :
