#!/bin/bash
source /opt/de_GWD/ui-node-lib
set -euo pipefail

tag=divert
if [[ -n ${2:-} ]]; then
    node_load nodeDT "$2"
    node_update "$NODE_CONF" --arg address "$address" '.v2nodeDIV.nodeDT.address=$address'
else
    node_load nodeDT
fi
outbound=$(node_outbound "$tag" "$address" "$tls" "$uuid" "$path")
chnIPs=$(jq -ce '.v2nodeDIV.nodeDT.CHNlistProxyIP // [] | if type == "array" and all(.[]; type == "string") then . else error("Invalid source IP list") end' "$NODE_CONF")
globalIPs=$(jq -ce '.v2nodeDIV.nodeDT.globalProxyIP // [] | if type == "array" and all(.[]; type == "string") then . else error("Invalid source IP list") end' "$NODE_CONF")
directIPs=$(jq -ce '.v2nodeDIV.nodeDT.directProxyIP // [] | if type == "array" and all(.[]; type == "string") then . else error("Invalid source IP list") end' "$NODE_CONF")
divertIPs=$(jq -n --argjson chn "$chnIPs" --argjson global "$globalIPs" '$chn + $global | unique')
node_remove "$tag"
node_put_outbound "$outbound"
node_rule "$tag" source "$divertIPs"
node_nft_set listBlan "$globalIPs"
node_nft_set listWlan "$directIPs"
node_update "$NODE_CONF" '.v2nodeDIV.nodeDT.status="on"'
if [[ ${1:-} == r ]]; then systemctl restart vtrui >/dev/null; fi
