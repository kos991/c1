#!/bin/bash
source /opt/de_GWD/ui-node-lib
set -euo pipefail
for tag in nodeSMyoutube nodeSMnetflix nodeSMhdh nodeSMtvb nodeSMbahamut nodeSMopenai nodeSMapple; do
    node_check "$tag" media || { printf '0\n-none-\n'; }
done
if [[ $(jq -r '.v2nodeDIV.nodeSM.steam // empty' "$NODE_CONF") == proxy ]]; then
    printf '1\n默认代理\n'
else
    printf '0\n-none-\n'
fi
