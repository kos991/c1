#!/bin/bash
set -e
. /opt/de_GWD/ui-dns-lib

# Keep domain routing lists and nft address sets in sync with the same input.
for kind in B W; do
    domains="/opt/de_GWD/mosdns/domains_list$kind"
    addresses="/opt/de_GWD/nftables/IP_list$kind"
    : >"$domains"
    : >"$addresses"
    jq -r --arg kind "$kind" '.dns["list" + $kind] // [] | .[]' /opt/de_GWD/0conf |
    while IFS= read -r domain; do
        [[ $domain =~ ^[A-Za-z0-9.*_-]+$ && $domain != -* ]] || continue
        printf '%s\n' "$domain" >>"$domains"
        # A literal wildcard is a domain routing rule, not a DNS query.
        [[ $domain == *\** ]] && continue
        local_port=5331
        [[ $kind == B ]] && local_port=5332
        dig @127.0.0.1 "$domain" -4 -p "$local_port" +short |
        while IFS= read -r ip; do
            [[ $ip =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] && printf '%s,\n' "$ip" >>"$addresses"
        done
    done
    sort -u -o "$domains" "$domains"
    sort -u -o "$addresses" "$addresses"
    cat >"/opt/de_GWD/nftables/SET_list$kind.nft" <<EOF
#!/usr/sbin/nft -f
table ip de_GWD {
    set list$kind {
        type ipv4_addr
        flags interval
        auto-merge
        $([[ ! -s $addresses ]] || printf 'elements = { %s }' "$(cat "$addresses")")
    }
}
EOF
    chmod 0755 "/opt/de_GWD/nftables/SET_list$kind.nft"
    gwd_update_dns_set "list$kind" "$addresses"
done

# Apple and games routing must be preserved when rebuilding domain lists.
/opt/de_GWD/ui-submitListBWsm
