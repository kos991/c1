#!/usr/bin/env php
<?php
/**
 * Password hashing helper for de_GWD provisioning and updates.
 * Reads password from stdin, outputs hash to stdout.
 * Supports PASSWORD_DEFAULT (bcrypt/argon2) and verifies legacy BALLOON-SHA256.
 */

// Disable output buffering and set binary mode
ini_set('display_errors', '0');
ini_set('log_errors', '1');

$stdin = fgets(STDIN);
if ($stdin === false || $stdin === '') {
    fwrite(STDERR, "Error: No password provided via stdin\n");
    exit(1);
}

$password = rtrim($stdin, "\n\r");

// Verify password is not empty and reasonable length
if (strlen($password) < 1 || strlen($password) > 72) {
    fwrite(STDERR, "Error: Password must be 1-72 characters\n");
    exit(1);
}

// Hash using PASSWORD_DEFAULT (bcrypt on PHP 7.4, argon2id on PHP 8+)
// PASSWORD_DEFAULT automatically selects the best algorithm available
$hash = password_hash($password, PASSWORD_DEFAULT);

if ($hash === false) {
    fwrite(STDERR, "Error: Failed to hash password\n");
    exit(1);
}

// Output the hash to stdout
fwrite(STDOUT, $hash . "\n");
exit(0);
