#!/bin/bash
# Page titles now render the escaped alias from 0conf at request time.
# Retain this command for existing callers, validating the shared setting only.
jq -e '.address.alias | type == "string" and (test("[[:cntrl:]]") | not)' /opt/de_GWD/0conf >/dev/null || exit 1
chown root:www-data /opt/de_GWD/0conf
chmod 0660 /opt/de_GWD/0conf
