#!/bin/bash
source /opt/de_GWD/ui-node-lib
set -euo pipefail

[[ ${1:-} =~ ^[0-9]{1,9}$ ]] || exit 1
node_load default "$1"
tls=${tls:-$domain}
node_update "$NODE_CONF" --arg domain "$domain" --arg tls "$tls" --argjson port "$port" --arg uuid "$uuid" --arg path "$path" '.update.v2node={domain:$domain,tls:$tls,port:($port|tostring),uuid:$uuid,path:$path}'
outbound=$(node_outbound default "$address" "$tls" "$uuid" "$path")
node_put_outbound "$outbound"
systemctl restart vtrui
