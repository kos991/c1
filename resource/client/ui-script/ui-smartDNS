#!/bin/bash
set -e
. /opt/de_GWD/ui-dns-lib

conf=/opt/de_GWD/0conf
smartconf=/opt/de_GWD/smartdns/smartdns.conf

doh1=$(jq -r '.dns.doh[0] // empty' "$conf")
doh2=$(jq -r '.dns.doh[1] // empty' "$conf")
dog=$(jq -r '.dns.dog // empty' "$conf")

# Bootstrap the encrypted resolvers through the unencrypted domestic DNS port.
doh1ip= doh2ip= dogip= dogdomain= dogport=
if [[ -n $doh1 ]]; then
    doh1ip=$(gwd_resolve_dns_ip "${doh1%%[:/]*}") || doh1ip=
fi
if [[ -n $doh2 ]]; then
    doh2ip=$(gwd_resolve_dns_ip "${doh2%%[:/]*}") || doh2ip=
fi
if [[ -n $dog ]]; then
    dogdomain=${dog%%:*}
    dogport=${dog#*:}
    if [[ $dog == *:* && $dogport =~ ^[0-9]{1,5}$ ]] &&
       ((10#$dogport >= 1 && 10#$dogport <= 65535)); then
        dogip=$(gwd_resolve_dns_ip "$dogdomain") || dogip=
    fi
fi

if [[ -n $dogip ]]; then
    gwd_coredns_block DoGc "$(cat <<EOF
# DoGc_START
.:5333 {
  bind 127.0.0.1
  grpc . $dogip:$dogport {
    tls
    tls_servername $dogdomain
  }
  template ANY AAAA {
    rcode NXDOMAIN
  }
  reload 6s 3s
}
# DoGc_END
EOF
)"
else
    gwd_coredns_block DoGc ''
fi

# Keep the independently configured DoG server when rebuilding the client block.
if [[ $(jq -r '.FORWARD.DoGs.status // empty' "$conf") == on ]]; then
    /opt/de_GWD/ui-DoGsSave
fi

mkdir -p /opt/de_GWD/smartdns
cat >"$smartconf" <<'EOF'
server-name smartdns

bind 127.0.0.1:5331
bind-tcp 127.0.0.1:5331
bind 127.0.0.1:5332 -group DNS_global -no-speed-check -no-cache
bind-tcp 127.0.0.1:5332 -group DNS_global -no-speed-check -no-cache

speed-check-mode tcp:443,ping,tcp:80
response-mode first-ping
force-AAAA-SOA yes
dualstack-ip-selection no
cache-size 32768
cache-persist yes
cache-file /tmp/smartdns
cache-checkpoint-time 28800
prefetch-domain yes
serve-expired-prefetch-time 21600
rr-ttl 600
rr-ttl-min 60
rr-ttl-max 3600
local-ttl 60
serve-expired yes
serve-expired-ttl 3600
serve-expired-reply-ttl 3
EOF

china=$(jq -r '.dns.china // empty' "$conf")
if [[ -z $china ]]; then
    china='114.114.114.114 119.29.29.29 180.76.76.76 223.5.5.5 223.6.6.6'
    jq --arg dnsChina "$china" '.dns.china=$dnsChina' "$conf" | sponge "$conf"
    chown root:www-data "$conf"
    chmod 0660 "$conf"
fi
for server in $china; do
    if [[ $server =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}(:[0-9]{1,5})?$ ]]; then
        printf 'server %s\n' "$server" >>"$smartconf"
    fi
done

if [[ -n $doh1ip ]]; then
    gwd_doh_server "$doh1" "$doh1ip" >>"$smartconf" || doh1ip=
fi
if [[ -n $doh2ip ]]; then
    gwd_doh_server "$doh2" "$doh2ip" >>"$smartconf" || doh2ip=
fi
if [[ -n $dogip ]]; then
    printf 'server-tcp 127.0.0.1:5333 -group DNS_global -exclude-default-group\n' >>"$smartconf"
fi
chmod 0644 "$smartconf"

# The DNS IP set is sourced only from the configured, resolved encrypted upstreams.
mkdir -p /opt/de_GWD/nftables
{
    [[ -z $dogip ]] || printf '%s\n' "$dogip"
    [[ -z $doh1ip ]] || printf '%s\n' "$doh1ip"
    [[ -z $doh2ip ]] || printf '%s\n' "$doh2ip"
} | sort -u | while IFS= read -r ip; do printf '%s,\n' "$ip"; done >/opt/de_GWD/nftables/IP_GlobalDNS
cat >/opt/de_GWD/nftables/SET_GlobalDNS.nft <<EOF
#!/usr/sbin/nft -f
table ip de_GWD {
    set GlobalDNS {
        type ipv4_addr
        flags interval
        auto-merge
        $([[ ! -s /opt/de_GWD/nftables/IP_GlobalDNS ]] || printf 'elements = { %s }' "$(cat /opt/de_GWD/nftables/IP_GlobalDNS)")
    }
}
EOF
chmod 0755 /opt/de_GWD/nftables/SET_GlobalDNS.nft
if nft list set ip de_GWD GlobalDNS >/dev/null 2>&1; then
    nft flush set ip de_GWD GlobalDNS
    if [[ -s /opt/de_GWD/nftables/IP_GlobalDNS ]]; then
        nft add element ip de_GWD GlobalDNS "{ $(cat /opt/de_GWD/nftables/IP_GlobalDNS) }"
    fi
fi

jq --arg one "$doh1ip" --arg two "$doh2ip" '.dns.doh1re=$one | .dns.doh2re=$two' "$conf" | sponge "$conf"
chown root:www-data "$conf"
chmod 0660 "$conf"
systemctl restart smartdns
