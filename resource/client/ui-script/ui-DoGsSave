#!/bin/bash
set -e
. /opt/de_GWD/ui-dns-lib

port=$(jq -r '.FORWARD.DoGs.port // empty' /opt/de_GWD/0conf)
[[ $port =~ ^[0-9]{1,5}$ ]] && ((10#$port >= 1 && 10#$port <= 65535)) || exit 1
[[ -f /var/www/ssl/de_GWD.cer && -f /var/www/ssl/de_GWD.key ]] || exit 1

gwd_coredns_block DoGs "$(cat <<EOF
# DoGs_START
grpc://.:$port {
  tls /var/www/ssl/de_GWD.cer /var/www/ssl/de_GWD.key
  forward . 127.0.0.1:53 {
    prefer_udp
  }
}
# DoGs_END
EOF
)"
