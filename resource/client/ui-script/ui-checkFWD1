#!/bin/bash
set -euo pipefail
file=/opt/de_GWD/vtrui1/config.json
[[ -f $file ]] || exit 0
address=$(jq -er '.outbounds[0].settings.vnext[0].address | select(type == "string" and length > 0)' "$file")
port=$(jq -er '.outbounds[0].settings.vnext[0].port | select(type == "number" and . >= 1 and . <= 65535)' "$file")
if [[ $address == *:* ]]; then address="[$address]"; fi
endpoint=$address
if [[ $port != 443 ]]; then endpoint="$address:$port"; fi
jq -r --arg endpoint "$endpoint" '.v2node[] | select(.domain == $endpoint) | .name' /opt/de_GWD/0conf
printf '%s\n' "$endpoint"
