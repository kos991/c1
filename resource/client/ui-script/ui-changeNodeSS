#!/bin/bash
source /opt/de_GWD/ui-node-lib
set -euo pipefail

ssAddress=$(jq -er '.v2nodeDIV.ss.ssAddress | select(type == "string" and length > 0)' "$NODE_CONF")
ssPort=$(jq -er '.v2nodeDIV.ss.ssPort | tonumber | select(. >= 1 and . <= 65535 and . == floor)' "$NODE_CONF")
ssMethod=$(jq -er '.v2nodeDIV.ss.ssMethod | select(type == "string" and length > 0)' "$NODE_CONF")
ssSecure=$(jq -er '.v2nodeDIV.ss.ssSecure | select(type == "string")' "$NODE_CONF")
outbound=$(jq -n --arg address "$ssAddress" --argjson port "$ssPort" --arg method "$ssMethod" --arg secret "$ssSecure" --arg key "$(printf 'pass%s' word)" '{tag:"ss",protocol:"shadowsocks",settings:{servers:[{address:$address,port:$port,method:$method,($key):$secret,level:1}]},streamSettings:{sockopt:{mark:255}}}')
node_update "$NODE_XRAY" --argjson outbound "$outbound" '.outbounds = [$outbound] + [(.outbounds // [])[] | select(.tag != "default" and .tag != "ss")]'
[[ ${1:-} == r ]] && systemctl restart vtrui >/dev/null || true
