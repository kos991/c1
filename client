pkgDEP2(){
if [[ ! -s /usr/share/keyrings/docker-archive-keyring.gpg ]]; then
    local keyfile
    keyfile=$(mktemp) || return 1
    curl -fsSL -o "$keyfile" https://download.docker.com/linux/debian/gpg || { rm -f "$keyfile"; return 1; }
    gpg --dearmor --yes -o "$keyfile.gpg" "$keyfile" || { rm -f "$keyfile" "$keyfile.gpg"; return 1; }
    install -m 0644 "$keyfile.gpg" /usr/share/keyrings/docker-archive-keyring.gpg
    rm -f "$keyfile" "$keyfile.gpg"
fi
echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian $(. /etc/os-release; printf '%s' "$VERSION_CODENAME") stable" >/etc/apt/sources.list.d/docker.list


unset aptPKG
[[ -z $(dpkg -l | awk '{print$2}' | grep '^python3-toml$') ]] && aptPKG+=(python3-toml)
[[ -z $(dpkg -l | awk '{print$2}' | grep '^psmisc$') ]] && aptPKG+=(psmisc)
[[ -z $(dpkg -l | awk '{print$2}' | grep '^dns-root-data$') ]] && aptPKG+=(dns-root-data)
[[ -z $(dpkg -l | awk '{print$2}' | grep '^idn2$') ]] && aptPKG+=(idn2)
[[ -z $(dpkg -l | awk '{print$2}' | grep '^ethtool$') ]] && aptPKG+=(ethtool)
[[ -z $(dpkg -l | awk '{print$2}' | grep '^tmux$') ]] && aptPKG+=(tmux)
[[ -z $(dpkg -l | awk '{print$2}' | grep '^socat$') ]] && aptPKG+=(socat)
[[ -z $(dpkg -l | awk '{print$2}' | grep '^zip$') ]] && aptPKG+=(zip)
