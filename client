    local package
    package=$(mktemp --suffix=.deb) || return 1
    curl -fsSL -o "$package" 'https://deb.debian.org/debian/pool/main/m/mimalloc/libmimalloc2.0_2.0.9+ds-2_amd64.deb' || { rm -f "$package"; return 1; }
    echo "a20035605a532be3186f0f48607c7106fe2a5551066c29de663c965692c446c4  $package" | sha256sum -c - || { rm -f "$package"; return 1; }
    dpkg -i "$package" || { rm -f "$package"; return 1; }
    rm -f "$package"
fi
}

phpVersionForDebian(){
case $debianCodename in
  trixie) echo 8.4 ;;
  bookworm) echo 8.2 ;;
  *) echo "Unsupported Debian release: $debianCodename (supported: bookworm, trixie)" >&2; return 1 ;;
esac
}


installNativePHP(){
local phpVersion
phpVersion=$(phpVersionForDebian) || return 1
rm -f /etc/apt/sources.list.d/php.list
apt-get update && apt-get install -y "php${phpVersion}-cli" "php${phpVersion}-fpm" "php${phpVersion}-cgi" "php${phpVersion}-sqlite3" "php${phpVersion}-xml" "php${phpVersion}-intl" "php${phpVersion}-opcache" "php${phpVersion}-zip" "php${phpVersion}-mbstring" "php${phpVersion}-mysql" "php${phpVersion}-curl" "php${phpVersion}-gd" || return 1
update-alternatives --set php "/usr/bin/php${phpVersion}" || return 1
}

checkSum(){
sha256sumL=$(sha256sum $1 2>/dev/null | awk '{print$1}')
if [[ $sha256sumL = $2 ]]; then 
  echo "true"
elif [[ $sha256sumL != $2 ]]; then
  echo "false"
fi
}



preDL(){
mkdir -p /opt/de_GWD
mkdir -p /opt/de_GWD/.repo

sha256sum_IPchnroute=$(curl -fsSLo- https://ghproxy.net/https://raw.githubusercontent.com/jacyl4/chnroute/main/IPchnroute.sha256sum)
if [[ -n $sha256sum_IPchnroute ]] && [[ $(checkSum /opt/de_GWD/.repo/IPchnroute $sha256sum_IPchnroute) = "false" ]] ; then
rm -rf /tmp/IPchnroute
wget --no-check-certificate --show-progress -cqO /tmp/IPchnroute https://ghproxy.net/https://raw.githubusercontent.com/jacyl4/chnroute/main/IPchnroute
[[ $(checkSum /tmp/IPchnroute $sha256sum_IPchnroute) = "false" ]] && echo -e "${WHITE}IPchnroute${RED} Download Failed${cRES}" && exit
[[ $(checkSum /tmp/IPchnroute $sha256sum_IPchnroute) = "true" ]] && mv -f /tmp/IPchnroute /opt/de_GWD/.repo/IPchnroute
fi

if [[ -f "./de_GWD_$architecture.zip" ]]; then
    mv -f ./de_GWD_$architecture.zip /opt/de_GWD/.repo/de_GWD.zip
else
    sha256sum_de_GWD=$(curl -fsSLo- https://raw.githubusercontent.com/kos991/c1/main/de_GWD_"$architecture".zip.sha256sum)
    if [[ -n $sha256sum_de_GWD ]] && [[ $(checkSum /opt/de_GWD/.repo/de_GWD.zip $sha256sum_de_GWD) = "false" ]]; then
    rm -rf /tmp/de_GWD.zip
    wget --no-check-certificate --show-progress -cqO /tmp/de_GWD.zip https://raw.githubusercontent.com/kos991/c1/main/de_GWD_"$architecture".zip
    [[ $(checkSum /tmp/de_GWD.zip $sha256sum_de_GWD) = "false" ]] && rm -rf /tmp/de_GWD.zip && wget --no-check-certificate --show-progress -cqO /tmp/de_GWD.zip https://ghproxy.net/https://raw.githubusercontent.com/kos991/c1/main/de_GWD_"$architecture".zip
    [[ $(checkSum /tmp/de_GWD.zip $sha256sum_de_GWD) = "false" ]] && echo -e "${WHITE}de_GWD Zip${RED} Download Failed${cRES}" && exit
    [[ $(checkSum /tmp/de_GWD.zip $sha256sum_de_GWD) = "true" ]] && mv -f /tmp/de_GWD.zip /opt/de_GWD/.repo/de_GWD.zip
    fi
fi

if ! unzip -tq /opt/de_GWD/.repo/de_GWD.zip >/dev/null; then
    echo -e "${WHITE}de_GWD Zip${RED} Download Failed${cRES}" >&2
    return 1
fi

}



repoDL(){
echo -e "${WHITE}[...]\c" && echo -e "\t${WHITE}Repo Download${cRES}\r\c"
local asset destination digest source
for asset in "nginx_$architecture" nginxConf.zip; do
    destination=/opt/de_GWD/.repo/nginxConf.zip
    [[ $asset == nginxConf.zip ]] || destination=/usr/sbin/nginx
    source="./resource/nginx/$asset"
    if [[ -f $source ]]; then
        digest=$(tr -d '\r\n' <"$source.sha256sum") || return 1
        [[ $digest =~ ^[[:xdigit:]]{64}$ && $(checkSum "$source" "$digest") == true ]] || return 1
        cp -f "$source" "$destination" || return 1
    else
        digest=$(curl -fsSL "https://raw.githubusercontent.com/kos991/c1/$branch/resource/nginx/$asset.sha256sum") || return 1
        [[ $digest =~ ^[[:xdigit:]]{64}$ ]] || return 1
        if [[ $(checkSum "$destination" "$digest") != true ]]; then
            curl -fsSL -o "/opt/de_GWD/.repo/$asset.download" "https://raw.githubusercontent.com/kos991/c1/$branch/resource/nginx/$asset" || return 1
            [[ $(checkSum "/opt/de_GWD/.repo/$asset.download" "$digest") == true ]] || return 1
            mv -f "/opt/de_GWD/.repo/$asset.download" "$destination" || return 1
        fi
    fi
done
chmod 0755 /usr/sbin/nginx || return 1

if [[ $(ttyd -v 2>&1 | grep -o '[0-9]\.[0-9]\.[0-9]') != $TTYD_Ver ]]; then
wget --show-progress -cqO /tmp/ttyd https://github.com/tsl0922/ttyd/releases/download/$TTYD_Ver/ttyd.$(uname -m)
[[ $? -ne 0 ]] && echo -e "${WHITE}TTYD${RED} Download Failed${cRES}"
[[ $(du -sk /tmp/ttyd 2>/dev/null | awk '{print$1}') -gt 1000 ]] && mv -f /tmp/ttyd /usr/bin/ttyd && chmod +x /usr/bin/ttyd && TTYD_UPDATE="true"
fi

if [[ -f ./resource/client/Archive.zip ]]; then
    sha256sum_client=$(<./resource/client/Archive.zip.sha256sum)
    [[ $sha256sum_client =~ ^[[:xdigit:]]{64}$ ]] && [[ $(checkSum ./resource/client/Archive.zip "$sha256sum_client") == true ]] || { echo 'Local client archive checksum failed' >&2; return 1; }
    cp -f ./resource/client/Archive.zip /opt/de_GWD/.repo/client.zip || return 1
else
    sha256sum_client=$(curl -fsSLo- "https://raw.githubusercontent.com/kos991/c1/$branch/resource/client/Archive.zip.sha256sum") || return 1
    [[ $sha256sum_client =~ ^[[:xdigit:]]{64}$ ]] || { echo 'Remote client checksum invalid' >&2; return 1; }
    if [[ $(checkSum /opt/de_GWD/.repo/client.zip "$sha256sum_client") == false ]]; then
        wget --show-progress -cqO /tmp/client.zip "https://raw.githubusercontent.com/kos991/c1/$branch/resource/client/Archive.zip" || return 1
        [[ $(checkSum /tmp/client.zip "$sha256sum_client") == true ]] || { echo 'Client archive checksum failed' >&2; return 1; }
        mv -f /tmp/client.zip /opt/de_GWD/.repo/client.zip || return 1
    fi
fi
unzip -tq /opt/de_GWD/.repo/client.zip >/dev/null || return 1
for required in ui-script/ui-admin ui-script/ui-dns-lib ui-web/terminal-auth.php ui-web/act/helpers.php; do
    unzip -Z1 /opt/de_GWD/.repo/client.zip | grep -Fxq "$required" || { echo "Outdated client archive: missing $required" >&2; return 1; }
done
for retired in ui-web/app.php ui-web/ddns.php ui-web/act/onWG.php ui-web/act/installFileRun.php ui-script/ui-WGon ui-script/ui-ddnsCFon ui-script/ui-installFileRun; do
    if unzip -Z1 /opt/de_GWD/.repo/client.zip | grep -Fxq "$retired"; then
        echo "Outdated client archive: $retired" >&2; return 1
    fi
done

if [[ -f ./version.php ]]; then
    cp -f ./version.php /opt/de_GWD/.repo/version.php || return 1
else
    curl -fsSL -o /opt/de_GWD/.repo/version.php "https://raw.githubusercontent.com/kos991/c1/$branch/version.php" || return 1
fi

echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Repo Download${cRES}"
}



